# Copy to .env.local for local development. Never commit real values.

# Public site URL — used for canonical URLs, Open Graph, sitemap.xml and robots.txt.
# Set this to your production domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Supabase ───────────────────────────────────────────────────────────────────
# Project URL and publishable key from Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# ── Database (required for the admin dashboard and blog) ────────────────────────
# Neon Postgres connection string. Created automatically when you add the Neon
# integration on Vercel; pull it locally with `vercel env pull .env.local`.
# Any Postgres URL works for local development, e.g. postgres://user:pass@localhost:5432/portfolio
DATABASE_URL=postgres://user:password@your-neon-host.neon.tech/neondb?sslmode=require

# ── File storage (required for uploads in production) ──────────────────────────
# Vercel Blob read-write token. Created automatically when you connect a Blob store
# to the project on Vercel. Without it, uploads are saved to public/uploads in
# development only and are rejected in production.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your-token

# ── Initial admin account (used only by `npm run admin:create`) ────────────────
# Set these temporarily, run the script, then remove ADMIN_PASSWORD.
# The password must be at least 12 characters. The app never reads these at runtime.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-long-unique-password
ADMIN_NAME=

# ── Contact form SMTP (server-side only — never prefix with NEXT_PUBLIC_) ───────
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, and an App Password for SMTP_PASS.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password

# The "From" address. Many providers require this to match SMTP_USER or a verified sender.
SMTP_FROM="Portfolio Contact <your-smtp-username@example.com>"

# Where contact form messages are delivered. Defaults to the email in admin Settings if omitted.
CONTACT_EMAIL=you@example.com
