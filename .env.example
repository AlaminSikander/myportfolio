# Public site URL — used for canonical URLs, Open Graph, sitemap.xml and robots.txt.
# Set this to your production domain (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# SMTP settings for the contact form (server-side only — never prefix these with NEXT_PUBLIC_).
# Example for Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, and an App Password for SMTP_PASS.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password-or-app-password

# The "From" address. Many providers require this to match SMTP_USER or a verified sender.
SMTP_FROM="Portfolio Contact <your-smtp-username@example.com>"

# Where contact form messages are delivered. Defaults to alamin.6534@gmail.com if omitted.
CONTACT_EMAIL=alamin.6534@gmail.com
